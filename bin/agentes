#!/usr/bin/env bash
# Instalador e atualizador da frota de agentes da PKI Tecnologia.
set -euo pipefail

VERSAO="0.3.0"
ORG=pkitecnologia
REPO="$ORG/PKI-Agentes"
MARKET=pki-agentes
PKI_HOME="${PKI_HOME:-$HOME/PKI}"
CONHECIDOS="$HOME/.claude/plugins/known_marketplaces.json"
INSTALADOS="$HOME/.claude/plugins/installed_plugins.json"
USUARIO="$HOME/.claude/settings.json"
export CLAUDE_CODE_PLUGIN_PREFER_HTTPS=1

uso() {
  cat <<FIM
agentes $VERSAO: frota de agentes da PKI Tecnologia

uso: agentes instalar   instala ou atualiza tudo; pode rodar de novo quando quiser
     agentes --versao

O que o "instalar" faz:
  - instala o Claude Code, se faltar;
  - faz o login no GitHub (gh) e configura a credencial do git;
  - cria o PKI_HOME ($PKI_HOME) com segredos/ (modo 700) e .claude/settings.json;
  - liga a atualização automática do marketplace $MARKET e o idioma português do Brasil nas sessões do PKI_HOME;
  - instala no escopo de usuário todos os plugins do marketplace, inclusive os novos, e migra
    instalações antigas do escopo de projeto;
  - desliga os plugins da frota no ~/.claude/settings.json e liga-os só no PKI_HOME.

Depois, para abrir o maestro: pki

Programas que faltarem: brew upgrade $ORG/tap/agentes (ou brew reinstall).
FIM
}

passo() { printf '\n==> %s\n' "$*"; }
aviso() { printf '    %s\n' "$*"; }
erro() { printf '\nagentes: %s\n' "$*" >&2; exit 1; }

programas() {
  passo "Programas obrigatórios"
  local c faltam=""
  for c in gh jq git herdr; do command -v "$c" >/dev/null || faltam="$faltam $c"; done
  [ -z "$faltam" ] || erro "faltam:$faltam. Rode: brew reinstall $ORG/tap/agentes"
  if ! command -v claude >/dev/null; then
    aviso "Claude Code não encontrado; instalando pelo instalador oficial."
    curl -fsSL https://claude.ai/install.sh | bash
    export PATH="$HOME/.local/bin:$PATH"
    command -v claude >/dev/null || erro "Claude Code instalado, mas fora do PATH. Abra um terminal novo e rode de novo: agentes instalar"
  fi
  aviso "gh, jq, git, herdr e claude presentes."
}

github() {
  passo "GitHub"
  if ! gh auth status -h github.com >/dev/null 2>&1; then
    aviso "Faça o login com a sua conta do GitHub."
    gh auth login -h github.com -p https -w
  fi
  gh auth setup-git -h github.com
  gh api "repos/$REPO" --jq .full_name >/dev/null 2>&1 \
    || erro "a conta $(gh api user --jq .login 2>/dev/null) não tem acesso a $REPO. Aceite o convite da organização $ORG no GitHub (e-mail ou https://github.com/$ORG) e rode de novo: agentes instalar"
  aviso "conta $(gh api user --jq .login) com acesso a $REPO."
}

pki_home() {
  passo "PKI_HOME: $PKI_HOME"
  mkdir -p "$PKI_HOME/.claude"
  install -d -m 700 "$PKI_HOME/segredos"
  local s="$PKI_HOME/.claude/settings.json" tmp
  [ -s "$s" ] || echo '{}' >"$s"
  tmp="$(mktemp)"
  jq --arg m "$MARKET" --arg r "$REPO" \
    '.extraKnownMarketplaces[$m] = ((.extraKnownMarketplaces[$m] // {}) + {source: {source: "github", repo: $r}, autoUpdate: true})
     | .language //= "português do Brasil"' \
    "$s" >"$tmp" || { rm -f "$tmp"; erro "$s não é um JSON válido; corrija o arquivo e rode de novo."; }
  mv "$tmp" "$s"
  aviso "atualização automática do $MARKET e idioma $(jq -r .language "$s") em $s."
}

marketplace() {
  passo "Marketplace $MARKET"
  if [ -f "$CONHECIDOS" ] && jq -e --arg m "$MARKET" 'has($m)' "$CONHECIDOS" >/dev/null; then
    claude plugin marketplace update "$MARKET"
  else
    claude plugin marketplace add "$REPO"
  fi
}

# Instalação no escopo de usuário: o Claude Code só respeita instalações de projeto no diretório inicial
# da sessão, e as abas do pki-tarefa abrem em subpastas do PKI_HOME. Os plugins ficam desligados no
# settings do usuário (a frota não vale em outros projetos) e ligados no do PKI_HOME e, por --settings, nas abas.
plugins() {
  passo "Plugins (escopo de usuário, ligados só no $PKI_HOME)"
  local local_mkt catalogo p id dir ids=() ligados
  local_mkt="$(jq -r --arg m "$MARKET" '.[$m].installLocation // empty' "$CONHECIDOS")"
  catalogo="$local_mkt/.claude-plugin/marketplace.json"
  [ -f "$catalogo" ] || erro "catálogo do marketplace não encontrado em $catalogo."
  for p in $(jq -r '.plugins[].name' "$catalogo"); do
    id="$p@$MARKET"
    ids+=("$id")
    while IFS= read -r dir; do
      [ -n "$dir" ] || continue
      if [ -d "$dir" ] && (cd "$dir" && claude plugin uninstall "$id" --scope project >/dev/null); then
        aviso "$p: instalação antiga de projeto em $dir removida."
      else
        aviso "ATENÇÃO: não foi possível remover a instalação de projeto de $p em $dir; rode lá: claude plugin uninstall $id --scope project"
      fi
    done < <(jq -r --arg k "$id" '.plugins[$k] // [] | .[] | select(.scope == "project") | .projectPath' "$INSTALADOS" 2>/dev/null || true)
    if jq -e --arg k "$id" '.plugins[$k] // [] | any(.scope == "user")' "$INSTALADOS" >/dev/null 2>&1; then
      aviso "$p: já instalado."
    else
      claude plugin install "$id" --scope user
    fi
  done
  [ -s "$USUARIO" ] || echo '{}' >"$USUARIO"
  ligados="$(jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' "$USUARIO" | grep -c "@$MARKET\$" || true)"
  definir "$USUARIO" false "${ids[@]}"
  definir "$PKI_HOME/.claude/settings.json" true "${ids[@]}"
  [ "$ligados" -gt 0 ] && aviso "$ligados plugin(s) da frota estavam ligados em $USUARIO e foram desligados."
  aviso "plugins desligados em $USUARIO e ligados em $PKI_HOME/.claude/settings.json."
}

definir() {
  local arquivo="$1" valor="$2" tmp
  shift 2
  tmp="$(mktemp)"
  jq --argjson v "$valor" 'reduce $ARGS.positional[] as $k (.; .enabledPlugins[$k] = $v)' "$arquivo" --args "$@" >"$tmp" \
    || { rm -f "$tmp"; erro "$arquivo não é um JSON válido; corrija o arquivo e rode de novo."; }
  mv "$tmp" "$arquivo"
}

atalho_antigo() {
  local f
  for f in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -f "$f" ] && grep -qE "^[[:space:]]*alias[[:space:]]+pki=" "$f"; then
      aviso "ATENÇÃO: $f tem um alias pki antigo, que esconde o comando pki do instalador. Apague a linha \"alias pki=...\" e abra um terminal novo."
    fi
  done
}

herdr_claude() {
  passo "Herdr"
  herdr integration install claude >/dev/null && aviso "integração do Herdr com o Claude Code instalada."
}

instalar() {
  programas
  github
  pki_home
  marketplace
  plugins
  herdr_claude
  atalho_antigo
  passo "Pronto"
  aviso "Para abrir o maestro, numa aba do Herdr: pki"
  aviso "Se o pki só entrar na pasta ~/PKI sem abrir o maestro, o terminal é anterior à instalação: abra uma aba nova do Herdr ou rode hash -r, e tente de novo."
  aviso "Na primeira vez, o Claude Code pergunta se confia na pasta $PKI_HOME: escolha \"Yes, I trust this folder\"."
  aviso "Quando a frota avisar de plugin novo, rode de novo: agentes instalar"
}

case "${1:-}" in
  instalar) instalar ;;
  --versao|-v) echo "agentes $VERSAO" ;;
  ""|-h|--help|ajuda) uso ;;
  *) uso >&2; exit 2 ;;
esac
